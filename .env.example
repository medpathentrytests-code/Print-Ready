# PrintReady — Environment Variable Reference
# Copy this file to .env.local (development) or configure these as
# environment variables in your hosting provider (production).
# See docs/DEPLOYMENT.md for full setup instructions.

# ---------------------------------------------------------------------------
# REQUIRED — Session signing secret
# ---------------------------------------------------------------------------
# Used to sign the app's session cookie (HS256 JWT). Generate a long random
# value, e.g.: openssl rand -hex 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# REQUIRED — PDF processing microservice
# ---------------------------------------------------------------------------
# URL of the Python/FastAPI PDF analysis service (see /pdf-service).
# Local dev default shown below; in production point this at wherever you
# deploy the pdf-service (Render, Railway, Fly.io, a VM, etc).
PDF_SERVICE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# REQUIRED — Shared storage paths (used by both Next.js and the PDF service
# when running on the same filesystem; see docs/DEPLOYMENT.md for the
# object-storage alternative recommended for serverless hosting)
# ---------------------------------------------------------------------------
PRINTREADY_STORAGE_DIR=/absolute/path/to/printready/storage
PRINTREADY_DATA_DIR=/absolute/path/to/printready/data

# ---------------------------------------------------------------------------
# OPTIONAL — Supabase (production database + auth)
# Leave all three blank to run PrintReady on the built-in local SQLite
# adapter (zero config, great for development/demo). Fill in all three to
# switch the whole app to production Supabase with no code changes.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — App URL (used for email redirect links, sitemap, robots.txt)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OPTIONAL — Scheduled cleanup job protection
# ---------------------------------------------------------------------------
# If set, /api/cron/cleanup requires this value in the `x-cron-secret` header.
CRON_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — Live billing via Freemius
# Leave blank to keep the product in free demo/evaluation mode (instant plan
# switching in Settings, no real charges). Fill all four in to enable real,
# worldwide checkout via Freemius (a merchant-of-record, so it handles cards,
# tax/VAT, invoicing, and renewals for you). Setup: see docs/BILLING_SETUP.md
# for exactly where to find each value in the Freemius Developer Dashboard.
# ---------------------------------------------------------------------------
FREEMIUS_PRODUCT_ID=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
# Plan IDs for the two paid tiers — create "Pro" ($9/mo) and "Business"
# ($19/mo) plans under your product in the Freemius Dashboard first, then
# paste each plan's ID here.
FREEMIUS_PRO_PLAN_ID=
FREEMIUS_BUSINESS_PLAN_ID=
# Set to "sandbox" to test checkout without real charges (Freemius sandbox
# mode); leave unset/blank for live, real-money checkout.
FREEMIUS_MODE=
# Required for subscription state (renewals/cancellations) to sync even when
# a user never returns to the app: register
# https://<your-domain>/api/billing/freemius/webhook in the Freemius
# Dashboard under Integration > Webhooks.
