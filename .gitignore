# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PrintReady — local data & runtime storage (never ship real user data)
/data/
/storage/uploads/*
/storage/thumbnails/*
/storage/reports/*
!/storage/samples/
!/storage/uploads/.gitkeep
!/storage/thumbnails/.gitkeep
!/storage/reports/.gitkeep

# Python PDF service
pdf-service/__pycache__/
pdf-service/**/__pycache__/
pdf-service/.venv/
pdf-service/venv/
*.pyc
